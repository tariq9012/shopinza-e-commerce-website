{
  "name": "shopinza-backend",
  "version": "1.0.0",
  "description": "Backend API for the Shopinza e-commerce website (auth, orders, contact, newsletter, products, admin).",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seedProducts.js",
    "make-admin": "node seed/makeAdmin.js",
    "verify-existing-users": "node seed/verifyExistingUsers.js",
    "test": "node --test --test-timeout=30000 tests/unit.test.js tests/routes.test.js tests/phase21.test.js tests/switch.test.js tests/upload.test.js tests/server.test.js",
    "test:redis": "node --test --test-timeout=30000 tests/redis.test.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^9.14.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.14",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "socket.io": "^4.7.5",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
