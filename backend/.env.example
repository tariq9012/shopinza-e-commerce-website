# Copy this file to .env and fill in your own values.
# Never commit the real .env file to GitHub.

# MongoDB connection string (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/shopinza

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the server runs on
PORT=5000

# Comma-separated list of origins allowed to call this API
# (add your deployed frontend URL here once you host it, e.g. GitHub Pages / Netlify)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000
