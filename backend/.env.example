# Copy this file to .env for LOCAL development and fill in your own values.
# Placeholders only - NEVER commit the real .env file.
# On Vercel these go in: Project -> Settings -> Environment Variables (not in a file).

# ---------- Core ----------
# MongoDB connection string (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/shopinza
# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Local only - Vercel ignores PORT
PORT=5000
# Comma-separated origins allowed to call the API cross-origin. Not needed on
# Vercel (frontend and API share one origin) - only for the separate local setup.
CLIENT_ORIGIN=http://127.0.0.1:5501,http://localhost:5501,http://localhost:3000
# Public base URL of the site, no trailing slash. Used in emails and payment redirects.
# Vercel: https://your-domain (NOT a /frontend sub-path). Local: http://127.0.0.1:5501/...
FRONTEND_URL=http://127.0.0.1:5501

# ---------- Guest "Track your order" email links ----------
# Secret that signs the read-only tracking token put in order emails (#track=...).
# REQUIRED in production (without it emails simply contain no token). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating it invalidates every previously emailed tracking link.
ORDER_TRACKING_SECRET=replace_with_a_long_random_secret

# ---------- Currency: JazzCash / Easypaisa charge PKR ----------
# The store is priced in USD (Stripe also charges USD). JazzCash/Easypaisa charge PKR, so they
# stay DISABLED until you set this deliberate rate (PKR per 1 USD, e.g. the rate you want to
# apply). It is never guessed: leave empty and those two payment methods are not offered.
# The exact PKR amount + rate used is saved on each order when the payment starts.
USD_TO_PKR_RATE=

# ---------- Redis (OPTIONAL but recommended on Vercel) ----------
# With it: live order updates / "X viewing" work across ALL Vercel instances, and
# rate limits are shared. Without it everything still works, per instance only.
# Any Redis with a rediss:// URL works (e.g. Upstash / Redis from the Vercel Marketplace).
REDIS_URL=

# ---------- Scheduled cleanup of abandoned online-payment orders ----------
# Required on Vercel: Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# The endpoint refuses every request while this is empty.
CRON_SECRET=replace_with_a_long_random_secret
ORDER_ABANDON_MINUTES=30
# Local dev interval only (Vercel uses vercel.json's cron schedule instead)
ORDER_CLEANUP_INTERVAL_MINUTES=10

# ---------- Cloudinary (image hosting) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------- JazzCash (sandbox) ----------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX_URL=
JAZZCASH_RETURN_URL=

# ---------- Easypaisa (sandbox) ----------
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_SANDBOX_URL=
EASYPAISA_RETURN_URL=

# ---------- Outgoing email (verification + password reset) ----------
# Leave blank in development: emails are printed to the terminal instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---------- Social login (optional) ----------
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
